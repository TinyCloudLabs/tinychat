{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exo",
  "version": "0.1.0",
  "identifier": "xyz.tinycloud.exo",
  "build": {
    "beforeDevCommand": "bun run --cwd ../frontend dev",
    "devUrl": "http://localhost:5186",
    "beforeBuildCommand": "bun run --cwd ../frontend build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Exo",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Exo — private chat and meeting memory on TinyCloud",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
