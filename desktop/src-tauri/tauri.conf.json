{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exo",
  "version": "../package.json",
  "identifier": "xyz.tinycloud.exo",
  "build": {
    "beforeDevCommand": "bun run --cwd ../frontend dev",
    "devUrl": "http://localhost:5186",
    "beforeBuildCommand": "bun run --cwd ../frontend build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Exo",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.tinycloud.chat https://tee.node.tinycloud.xyz https://node.tinycloud.xyz https://registry.tinycloud.xyz https://openkey.so https://api.openkey.so https://api.redpill.ai https://rpc.ata.network https://search.sigstore.dev https://api-github-proxy.tinfoil.sh https://gh-attestation-proxy.tinfoil.sh https://api.fireflies.ai https://www.googleapis.com https://docs.googleapis.com https://meet.googleapis.com",
        "frame-src": "https://openkey.so",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'self'"
      }
    }
  },
  "bundle": {
    "macOS": {
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "14.2"
    },
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Exo — private chat and meeting memory on TinyCloud",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
