{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "transcription",
  "description": "Local meeting capture and transcription: on-device (anarlog plugins) or private cloud (Exo's cloud_transcription_* commands). Applied at runtime only when the `transcription` Cargo feature is enabled. Grants exactly the commands the Local recording UI invokes; event listening comes from core:default. The webview may not emit events: Exo's native capture registry trusts the transcription plugin's `stopped` event, so the webview must not be able to forge one.",
  "windows": ["main"],
  "permissions": [
    "transcription:allow-list-microphone-devices",
    "transcription:allow-start-capture",
    "transcription:allow-stop-capture",
    "transcription:allow-get-capture-state",
    "transcription:allow-start-transcription",
    "transcription:allow-stop-transcription",
    "local-stt:allow-is-model-downloaded",
    "local-stt:allow-download-model",
    "local-stt:allow-start-server",
    "allow-cloud-transcription-status",
    "allow-cloud-transcription-submit",
    "allow-cloud-transcription-cancel",
    "allow-cloud-transcription-reopen",
    "allow-append-audio-chunk",
    "allow-audio-file-size",
    "allow-read-audio-chunk",
    "allow-finalize-audio-file",
    "allow-recorder-whisper-audio-path",
    "allow-delete-audio-file",
    "allow-recorder-start",
    "allow-recorder-pause",
    "allow-recorder-resume",
    "allow-recorder-stop",
    "allow-recorder-status",
    "allow-recorder-list-inputs",
    "allow-recorder-select-input",
    "allow-recorder-recover",
    "allow-recorder-acknowledge",
    "allow-recorder-failed-list",
    "allow-recorder-failed-retry",
    "allow-recorder-failed-delete",
    "allow-recorder-models-list",
    "allow-recorder-models-get",
    "allow-recorder-models-select",
    "allow-recorder-models-download",
    "allow-recorder-models-progress",
    "allow-recorder-system-audio-get",
    "allow-recorder-system-audio-set",
    "allow-recorder-auto-save-to-space-get",
    "allow-recorder-auto-save-to-space-set",
    "core:event:deny-emit",
    "core:event:deny-emit-to"
  ]
}
