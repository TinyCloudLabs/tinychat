+
+// tinychat stopgap until @openkey/sdk-capacitor ships the fix: Chromium before
+// 130 (Android System WebView 113) parses `xyz.app://openkey/callback` with
+// host '' and pathname '//openkey/callback'. Recover the authority from that
+// path. Mirrors the upstream redirectTarget() in packages/sdk-capacitor/src/client.ts.
+function redirectTarget(uri) {
+  const url = new URL(uri);
