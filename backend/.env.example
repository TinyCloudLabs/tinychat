BACKEND_PRIVATE_KEY=
TINYCLOUD_HOST=https://node.tinycloud.xyz
PORT=3014
# FRONTEND_URL defaults to https://localhost:5186 when local certs exist.
# Use a trusted local cert for OpenKey/passkey flows. HTTPS with a certificate
# warning still blocks WebAuthn.
# FRONTEND_URL=http://localhost:5186
REDPILL_API_KEY=
REDPILL_BASE_URL=https://api.redpill.ai/v1
REDPILL_DEFAULT_MODEL=z-ai/glm-5.2

# ── Stripe subscription gating (paywall) ──────────────────────────────────────
# Master switch. Default false: NO gating — every request runs as today and is
# treated as the free tier with no limits enforced. Flip to true only once the
# Stripe vars below are filled in. See docs/stripe-setup.md.
PAYWALL_ENABLED=false

# Secret key from the Stripe dashboard (Developers → API keys).
# Use a test-mode key (sk_test_...) until you go live. When PAYWALL_ENABLED is
# true but this is empty, everyone resolves to the free tier and the
# checkout/portal endpoints return 503 billing_not_configured.
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_...) from the webhook endpoint you create in the
# Stripe dashboard pointing at /api/billing/webhook.
STRIPE_WEBHOOK_SECRET=

# Price IDs (price_...) for each paid tier + billing interval. Copy these from
# the Stripe dashboard after creating the Plus and Pro products with monthly and
# yearly recurring prices. The display prices shown in the UI live in
# backend/src/billing/tiers.ts; the real charge amounts come from these prices.
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# ── Credit budgets (optional; defaults baked into tiers.ts) ───────────────────
# Per-tier credit allowance. Free resets at UTC midnight (per-day). Paid tiers
# reset on a per-week window anchored to the subscriber's Stripe billing-cycle
# anchor (subscription-stable across renewals; falls back to current_period_start
# then created). Invalid/non-positive values fall back to the default with a
# console warning — misconfig must not zero out a user's budget. The peg and
# rate ladder are product semantics and stay as code constants (see
# docs/credits.md).
#
# NOTE: the old CREDIT_BUDGET_PLUS / CREDIT_BUDGET_PRO names are IGNORED — paid
# budgets are now per-week and read from the _WEEKLY-suffixed names below.
# CREDIT_BUDGET_FREE=500
# CREDIT_BUDGET_PLUS_WEEKLY=12000
# CREDIT_BUDGET_PRO_WEEKLY=28000

# ── Universal Ledger Credits sidecar ─────────────────────────────────────────
# URL of the billing sidecar (Cloudflare Worker). When unset the ledger
# feature is silently disabled (no 500, no user-visible error).
# IMPORTANT: the Phala CVM allowed_envs whitelist is frozen at creation —
# run updateCvmEnvs to add these two vars before deploying, or the ledger
# shadow-push and rehydration will not activate.
# LEDGER_SERVICE_URL=https://billing.tinycloud.xyz
# LEDGER_SERVICE_SECRET=

# ── Connector webhooks (docs/connectors-spec.md) ─────────────────────────────
# Ships dark. false = the public /api/connectors/webhooks/* route is not mounted
# (404), the authenticated companion routes 404, the drain timer never starts and
# the frontend section is hidden. Flip to true only with the two secrets below set.
CONNECTOR_WEBHOOKS_ENABLED=false

# HMAC master. Every consenting user is shown the 32-byte HKDF output derived from
# this key under a public salt and a known info string, so they each hold a complete
# offline oracle against it: a weak master is a silent, total compromise of delivery
# authentication for EVERY user, not a per-user problem. Startup therefore refuses to
# boot on a value below 32 decoded bytes or on the placeholder deny-list, and logs
# only the accepted LENGTH. Generate with a CSPRNG, never a passphrase, and never
# reuse one of these three values for another:
#
#   openssl rand -base64 32
#
WEBHOOK_HMAC_MASTER=

# Rotation grace key. Set to the OUTGOING master while a rotation drains, so
# deliveries still signed with it verify (logged as sig_key=prev); leave empty
# otherwise. On a CONFIRMED master compromise do NOT set it — the grace window is
# the attacker's window. Generated the same way:
#
#   openssl rand -base64 32
#
WEBHOOK_HMAC_MASTER_PREV=

# Keys the `tid=`/`sig=`/`mid=`/`aid=` hashes in the world-readable CVM log stream.
# MUST NOT be derived from WEBHOOK_HMAC_MASTER and MUST NOT be rotated in the same
# deploy — rotating it deliberately breaks correlation with historical log lines:
#
#   openssl rand -base64 32
#
LOG_HASH_SALT=

# The public HTTPS origin every minted callback URL carries — the string users paste
# into their provider dashboard. Pinned here rather than derived from the request's
# Host header and forwarded scheme: a wrong host or an http:// scheme mints a webhook
# that silently never delivers. Origin only — https, no path, no trailing slash — or
# the backend refuses to build the companion router. Leave empty for local QA, where
# the host stays request-derived (the scheme is forced to https either way).
#
#   CONNECTOR_WEBHOOK_PUBLIC_ORIGIN=https://api.tinycloud.chat
#
CONNECTOR_WEBHOOK_PUBLIC_ORIGIN=

# The hostnames the PUBLIC delivery route will answer on (backend-ingest plan §8.1 W9 / §10;
# findings §6 control 6). A delivery arriving at anything else — a raw-IP probe, a stale domain
# still pointed at the CVM — is refused with the same generic 401 as any other pre-verify
# failure, before its body is read. Load-bearing under backend ingestion, where an off-target
# delivery would cost a credentialed upstream fetch and a stored copy of a meeting.
#
# LEAVE EMPTY normally: the allowlist is then DERIVED from CONNECTOR_WEBHOOK_PUBLIC_ORIGIN above,
# so the host we answer on cannot drift from the URL users paste into their dashboard. Set it
# only when the ingress rewrites Host and X-Forwarded-Host to something internal — a
# comma-separated list, or the single value `*` to disable the check entirely (loud, logged, and
# the ONLY way to turn it off; a value with no usable host is a hard startup error, never a
# silent disable). This is not an authentication boundary — the HMAC is; see
# docs/connector-webhooks-trust-proxy.md for what a forwarded header is worth here.
#
#   CONNECTOR_WEBHOOK_HOST_ALLOWLIST=api.tinycloud.chat,hooks.tinycloud.chat
#
CONNECTOR_WEBHOOK_HOST_ALLOWLIST=

# D4 = single-instance (DECISIONS; backend-ingest plan §8.1 W9, delta 11). Exactly ONE backend
# instance may consume the cohort's delivery queues — the queue's mutual exclusion is a
# per-address in-process mutex over a per-instance storage lane, so a second instance means
# interleaved read-modify-writes, lost enqueues and double fetches. A durable lease in the
# backend's own KV (`webhooks/ingest/instance-lease`) enforces it: a second instance refuses the
# seat and stays provably inert. Read docs/connector-webhooks-single-instance.md BEFORE scaling
# to two replicas — it is a design change, not a replica count.
#
# EMPTY = a random id per process, which is what a single CVM wants. Pin it only when the same
# logical instance redeploys and should reclaim its own lease immediately instead of waiting out
# the 90 s TTL. [A-Za-z0-9_-], max 64 chars; a malformed value falls back to a random id.
CONNECTOR_INGEST_INSTANCE_ID=

# Backend-owned ingestion. Ships DARK, and dark is the only state this repo enables: false
# means every address stays on the shipped browser-drain path, byte for byte, and the backend
# holds no provider credential and no copy of any meeting.
#
# true only ARMS the feature. Which addresses it applies to is a SECOND switch: a per-address
# cohort allowlist stored in the backend's own config KV under `webhooks/ingest/cohort`
# (`{"addresses":["0x…"]}`). For a cohort address the backend fetch worker becomes the sole
# consumer of that address's delivery queue — the browser's drain/ack become no-ops — and the
# backend holds a Fireflies credential and an encrypted server-side copy of meeting content.
# That is a deliberate, operator-signed reversal of two shipped invariants; do not enable it
# without the consent copy, the credential store and the breach runbook in place.
CONNECTOR_BACKEND_INGEST_ENABLED=false

# Credential custody master (backend-ingest plan §6.2). Required — and gated the same way
# WEBHOOK_HMAC_MASTER is, refusing to boot on a weak value — the moment
# CONNECTOR_BACKEND_INGEST_ENABLED=true, because from then on the backend holds a per-user
# Fireflies credential. It wraps the per-credential AES-256-GCM data key, so only ciphertext
# ever reaches the substrate. Its OWN value: reusing WEBHOOK_HMAC_MASTER here is a hard startup
# error, since one compromise must not be both custody and delivery authentication. It must also
# SURVIVE redeploys — a deploy that drops it orphans every stored credential:
#
#   openssl rand -base64 32
#
CONNECTOR_CREDENTIAL_MASTER=

# Content custody master (backend-ingest plan §8.1 W4 / DECISIONS D3). Required, and gated the
# same way, the moment CONNECTOR_BACKEND_INGEST_ENABLED=true — from then on the backend also
# holds a copy of the MEETING for every cohort user. It wraps the per-meeting AES-256-GCM data
# key, so only ciphertext ever reaches the substrate. Its OWN value: reusing WEBHOOK_HMAC_MASTER
# or CONNECTOR_CREDENTIAL_MASTER here is a hard startup error, since one compromise must not be
# both the content archive and delivery authentication (or credential custody). It must SURVIVE
# redeploys — a deploy that drops it orphans every stored meeting:
#
#   openssl rand -base64 32
#
CONNECTOR_CONTENT_MASTER=

# The registered Fireflies OAuth app (DECISIONS V-a-branch = b1: authorization code + PKCE S256,
# refresh tokens, upstream revoke on disconnect). Required with the ingest flag armed. Note the
# only documented Fireflies scopes are profile/email — the grant is NOT data-scoped, which is the
# blast radius the operator signed for; do not describe it as read-only anywhere.
FIREFLIES_OAUTH_CLIENT_ID=
FIREFLIES_OAUTH_CLIENT_SECRET=
FIREFLIES_OAUTH_REDIRECT_URI=

# Google Meet OAuth proxy (gmeet plan §6 WP-A). Ships DARK: anything but the literal `true`
# leaves the five /api/connectors/google/oauth/* routes unmounted, so the connector cannot start
# a flow at all. Set it to `true` only once the three vars below hold a REGISTERED Google Cloud
# OAuth client — armed with any of them empty, startup refuses to build the router rather than
# serving a half-configured OAuth proxy.
GOOGLE_MEET_OAUTH_ENABLED=false

# The registered Google Cloud OAuth client. The client secret is issued by Google, so there is
# nothing for us to generate here — copy it from the Cloud console and never commit a real one.
# The redirect URI must match the one registered on that client BYTE FOR BYTE, and must be the
# backend's own /callback path (the popup lands there, then postMessages `{code, state}` to the
# pinned app origin). The proxy stores nothing: no token or code is ever written to disk or KV.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.invalid/api/connectors/google/oauth/callback

# Optional tunables. EMPTY = the code default shown in the comment. A non-positive or
# non-integer value is a hard startup error — an anti-amplification control must
# never silently revert to its default. Listed as explicit assignments, like the seven
# vars above: a commented-out line reads as "not deployment-relevant", and these are.
#
# Default 300000 (5 min) — the queue-maintenance sweep interval (TTL / dead-letter promotion).
# It does NOT drain: under Option C the browser is the writer, so processing happens on the
# user's next authenticated visit, never on a timer.
CONNECTOR_DRAIN_INTERVAL_MS=
# Default 20 — Fireflies transcript fetches per address per rolling hour.
CONNECTOR_A_FETCH_CEILING_PER_HOUR=
# Default 20 — delegated secret reads per address per rolling hour.
CONNECTOR_A_SECRET_READ_CEILING_PER_HOUR=

# ── Transcriber (TinyCloud Private Transcription API) ────────────────────────
# Settings → Transcriber: paste a meeting link, a bot joins and a speaker-attributed
# transcript comes back. Both vars set = /api/transcriber/meetings mounts (behind the
# session auth); either empty = the routes do not exist and the card says so. The key
# is a static project key (tc_live_…) and stays in this process — the browser only
# talks to the per-address proxy. See TinyCloudLabs/tinycloud-private-transcription.
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=
# Bot display name in the meeting. Default: TinyCloud Private Notetaker
TRANSCRIPTION_BOT_NAME=
