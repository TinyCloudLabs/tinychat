{
  "manifest_version": 1,
  "app_id": "xyz.tinycloud.tinychat",
  "name": "TinyCloud Home",
  "description": "TinyCloud Home: your feed, chat and apps. Conversations and feed cards are stored in your TinyCloud space.",
  "defaults": false,
  "permissions": [
    {
      "service": "tinycloud.kv",
      "path": "threads/",
      "actions": ["get", "put", "del", "list"],
      "description": "Read and write chat threads, messages and chat share links."
    },
    {
      "service": "tinycloud.sql",
      "path": "threads",
      "actions": ["read", "write", "schema"],
      "description": "Store chat threads, messages and settings in your space's SQL database."
    },
    {
      "service": "tinycloud.sql",
      "path": "home_feed",
      "actions": ["read", "write", "schema"],
      "description": "Store your feed's connected agents and attention state."
    },
    {
      "service": "tinycloud.sql",
      "path": "feed/",
      "actions": ["read", "write", "schema"],
      "description": "Read agent cards and save your responses in separate feed databases."
    },
    {
      "service": "tinycloud.hooks",
      "space": "applications",
      "path": "sql/xyz.tinycloud.tinychat/feed/",
      "actions": ["subscribe"],
      "skipPrefix": true,
      "description": "Refresh your feed when its databases change."
    },
    {
      "service": "tinycloud.hooks",
      "space": "applications",
      "path": "sql/xyz.tinycloud.tinychat/home_feed",
      "actions": ["subscribe"],
      "skipPrefix": true,
      "description": "Refresh the feed when you connect an agent or change attention state."
    },
    {
      "service": "tinycloud.hooks",
      "space": "applications",
      "path": "sql/xyz.tinycloud.tinychat/threads",
      "actions": ["subscribe"],
      "skipPrefix": true,
      "description": "Keep your saved feed view in sync across devices."
    },
    {
      "service": "tinycloud.space",
      "path": "",
      "actions": ["info"],
      "skipPrefix": true
    }
  ]
}
