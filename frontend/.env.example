VITE_OPENKEY_HOST=https://openkey.so
# Local real-data validation only (Vite DEV + loopback page/backend required).
# Chat history, model selection, checkpoints and memory use a per-session Map;
# reload clears them. Existing account memory is not loaded. Settings and all
# connector sync/reconcile mounts are disabled; sign-in never creates a space.
# Automatic SDK account registration and encryption provisioning are suppressed
# on local sign-in instances (guarded hook names for pinned web-sdk 2.5.1).
# The backend and Eliza must also use their isolated local validation settings.
# VITE_LOCAL_VALIDATION=true
# Optional explicit node override. Production pins this while the public
# location registry is unavailable or misrouted.
# VITE_TINYCLOUD_HOST=https://tee.node.tinycloud.xyz

# VITE_BACKEND_URL is intentionally unset by default. The frontend derives it
# from the current page protocol:
# - http://localhost:5186 -> http://localhost:3014
# - https://localhost:5186 -> https://localhost:3014
#
# Uncomment this only when using trusted local certs for both dev servers.
# Do not run passkey/OpenKey flows on an HTTPS page with certificate errors;
# WebAuthn will be blocked even if the browser lets you click through.
# VITE_BACKEND_URL=https://localhost:3014
