{
  "name": "tinychat-retrieval",
  "version": "0.1.1-onboarding.25",
  "description": "Read existing TinyChat meeting metadata and transcript passages through TinyCloud CLI.",
  "envelopeVersion": 1,
  "runtime": {
    "node": ">=22.20.0",
    "platforms": [
      "macos",
      "linux"
    ],
    "dependencies": []
  },
  "cli": {
    "package": "@tinycloud/cli",
    "minimumVersion": "0.9.0",
    "setupMinimumVersion": "1.5.0-beta.20"
  },
  "entrypoint": "scripts/retrieve.mjs",
  "permissionManifest": "assets/permissions.json",
  "catalogs": {
    "supported": [
      "connector_meeting-sql"
    ],
    "excluded": [
      "user-kv-only"
    ]
  },
  "limits": {
    "envelopeBytes": 24000,
    "consumerResponseBytes": 98304,
    "bodyBytes": 8388608,
    "metadataPageRecords": 50,
    "searchBodiesPerInvocation": 20
  },
  "setupEntrypoint": "scripts/setup.mjs",
  "opencode": {
    "version": "1.18.31",
    "installer": "scripts/install-opencode.mjs",
    "plugin": "lib/opencode-plugin.mjs",
    "activation": "automatic-first-install",
    "activationNode": ">=22.20.0",
    "supportedActivationPlatforms": [
      "macos"
    ],
    "restartRequired": false
  }
}
