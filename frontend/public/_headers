# tinycloud.one before moving a visitor (src/lib/originMove.ts), so it is never cached and any origin may read it:
# the file holds only a commit hash, and a response header names one origin at most.
/version.json
  Cache-Control: no-store
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

