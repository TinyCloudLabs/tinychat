# PWA (vite-plugin-pwa, see vite.config.ts). The worker script and the manifest
# must always revalidate so a deploy reaches installed apps on their next check;
# the browser fetches sw.js itself (updateViaCache "none"), but a CDN or proxy
# would otherwise be allowed to keep an old copy. Hashed /assets/* stay cacheable;
# the precached index.html is revalidated by revision, not by these headers.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json
/icons/*
  Cache-Control: public, max-age=86400
# Self-hosted fonts. The version is in each file name, so a new version is a new URL.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# The build's commit (vite.config.ts `tinychat-version-json`). tinycloud.chat and home.tinycloud.xyz read it here on
# tinycloud.one before moving a visitor (src/lib/originMove.ts), so it is never cached and any origin may read it:
# the file holds only a commit hash, and a response header names one origin at most.
/version.json
  Cache-Control: no-store
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/handoff
  Referrer-Policy: no-referrer
/handoff/
  Referrer-Policy: no-referrer

/s/*
  Referrer-Policy: no-referrer
