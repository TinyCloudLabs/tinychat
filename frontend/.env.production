# Baked into the production frontend build (vite loads .env.production in build
# mode). Public config only — no secrets. These must match the Production build
# environment variables set in the Cloudflare Pages dashboard (the source of
# truth for Git-integration builds; wrangler.toml [vars] do NOT feed the build).
VITE_OPENKEY_HOST=https://openkey.so
VITE_BACKEND_URL=https://api.tinycloud.chat
VITE_TINYCLOUD_HOST=https://tee.node.tinycloud.xyz
# Private cloud transcription (ptx-batch): Upload audio and mobile voice notes PUT the recording here.
VITE_EXO_PTX_UPLOAD_ORIGIN=https://f6663e38e8fc0a7d706ec2facb861246ae0077d8-8080.dstack-pha-prod5.phala.network
# Native OpenKey sign-in (TC-775 E1): unset — the OpenKey server side (O3/O4)
# and the registered Exo native client do not exist in production yet. When
# they do, set the flag and registered client ID (and the redirect URI if it differs):
# VITE_EXO_NATIVE_OPENKEY=true
# VITE_OPENKEY_NATIVE_CLIENT_ID=<registered public client id>
# (VITE_OPENKEY_NATIVE_REDIRECT_URI defaults to xyz.tinycloud.exo://openkey/callback)
