<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Release entitlements (TC-3195), wired to the App target's Release configuration only (CODE_SIGN_ENTITLEMENTS).
  Debug keeps App.entitlements (the Health spike, TC-525).

  - associated-domains: recording share links (https://tinycloud.one/s/<id>#…) open in the app when the domain's
    apple-app-site-association file lists it; otherwise they open in the browser. The App ID needs the Associated
    Domains capability for a signed export.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:tinycloud.one</string>
	</array>
</dict>
</plist>
