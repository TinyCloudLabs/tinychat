<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Debug entitlements, wired to the App target's DEBUG configuration only (CODE_SIGN_ENTITLEMENTS). Release builds use
  App.Release.entitlements. The HealthKit keys are the Health spike (TC-525), compiled with the EXO_HEALTH Swift
  condition (HealthPlugin.swift): the App ID xyz.tinycloud.home would need the HealthKit capability first, and App
  Review then expects the HealthKit integration to be visible in the app and its description
  (mobile/docs/health-spike.md).

  - healthkit: read (and, for the spike's sample data, write) HealthKit.
  - healthkit.access: empty = no clinical health records (Health Records / FHIR).
  - healthkit.background-delivery: HKObserverQuery wakes via enableBackgroundDelivery (iOS 15+ requires it).
  - associated-domains: webcredentials:openkey.so, as in App.Release.entitlements (TC-520). openkey.so's
    apple-app-site-association lists only R4QVKA785H.xyz.tinycloud.home, so other bundle IDs get no association.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
	<key>com.apple.developer.healthkit.background-delivery</key>
	<true/>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:openkey.so</string>
	</array>
</dict>
</plist>
